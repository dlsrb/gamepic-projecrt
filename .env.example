# .env.example를 .env로 복사한 뒤 값을 채운다. .env는 깃에 올리지 않는다.
# Replit에서는 .env 대신 Secrets에 넣는다 (작업 화면과 배포 화면은 따로 — 배포 화면에 넣은 것만 배포에 적용)
HOST=
PORT=
DEBUG=
DB_PATH=
# 배포(HTTPS)에서만 true
COOKIE_SECURE=
# 스토어 자동 수집을 서버 안에서 하루 1번 (기본 true)
STORE_SYNC=
# DB·아이콘을 Replit Object Storage에 자동 백업·복원 (기본 false). 배포 화면 Secrets에만 true
# true인데 replit-object-storage를 못 가져오면 서버가 켜지지 않음
BACKUP=
# 아이콘 파일이 없는 게임을 서버가 켜질 때 스토어에서 다시 받기 (기본 true)
ICON_FETCH=
# 프록시 칸 수: X-Forwarded-For의 오른쪽에서 몇 번째를 실제 IP로 볼지 (기본 0 = 접속 주소 그대로, Replit 배포는 1)
PROXY_HOPS=
# IP당 1시간에 새로 만들 수 있는 사용자 수 (기본 60)
USER_CREATE_PER_HOUR=
# 쓰기 요청을 허용할 출처, 쉼표 구분 (기본: http://127.0.0.1:8000, http://localhost:8000)
# 예: https://gamepick.replit.app
ALLOWED_ORIGINS=
